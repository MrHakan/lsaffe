    <!-- ============================ About (§17.6) ============================ -->
    <string name="app_name_about" translatable="false">DeckWatch</string>
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_tagline">Offline LSA and FFE inspection, tracking and regulatory reference.</string>

    <string name="about_section_disclaimer">Disclaimer</string>
    <!--
      §17.6, verbatim, in every locale. translatable="false" is deliberate: a softened translation
      of a legal disclaimer is worse than an English one, and this exact wording is what appears in
      the footer of every exported report a third party will read.
    -->
    <string name="about_disclaimer" translatable="false">DeckWatch is a planning and record-keeping aid. It is not a certificate, not a substitute for the vessel\'s approved plans, the manufacturer\'s manuals, class rules or the flag Administration\'s instructions, and it does not discharge any statutory obligation. Regulatory content is a summary captured on a stated date and may be superseded. Always verify against the current instrument and the vessel\'s own documentation. The Master\'s and the Company\'s responsibilities under SOLAS and the ISM Code are unaffected.</string>

    <string name="about_section_content">Where the content comes from</string>
    <string name="about_content_body">Every regulatory card names the instrument it summarises, the date it was captured and whether that figure has been verified. Cards marked “verify against the current instrument” are exactly that — unconfirmed.</string>
    <string name="about_content_sources">docs/REGULATORY_SOURCES.md — every instrument cited, with its capture date</string>
    <string name="about_content_symbols">docs/SYMBOL_LICENSING.md — how each pictogram was drawn and what a signage deployment still needs</string>
    <string name="about_content_model">docs/DATA_MODEL.md — the record schema behind exports and backups</string>

    <string name="about_section_flags">Check for newer flag notice revisions</string>
    <string name="about_flags_body">Flag-state notices change and DeckWatch never claims a revision is current. These links open the registry\'s own public notice index in your browser — the only time this app uses the network, and only when you tap.</string>
    <string name="about_flag_rmi">Marshall Islands registry (external)</string>
    <string name="about_flag_liberia">Liberian registry (external)</string>
    <string name="about_flag_panama">Panama Maritime Authority (external)</string>
    <string name="about_flag_no_browser">No browser is available to open that link</string>

    <string name="about_section_licence">Licence</string>
    <string name="about_licence_body">DeckWatch\'s source code is MIT-licensed. The regulatory content and the symbol artwork have their own provenance and are not covered by that licence.</string>

