<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The platform theme behind the Compose UI. Compose paints everything above it; this only has
      to be a transparent-status-bar, no-action-bar host whose window background matches the Day
      theme's ground so a configuration change never flashes a white or black rectangle.
    -->
    <style name="Theme.DeckWatch" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/deckwatch_window_background</item>
    </style>

    <!--
      The launch theme — androidx.core.splashscreen. Declared on MainActivity in the manifest and
      swapped for Theme.DeckWatch by installSplashScreen() via postSplashScreenTheme.

      The icon is the launcher's own foreground on the launcher's own background, so the splash is
      literally the app icon growing out of the tap — no second piece of artwork to keep in step.
    -->
    <style name="Theme.DeckWatch.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DeckWatch</item>
    </style>
</resources>
