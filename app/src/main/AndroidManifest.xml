<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Local reminder notifications only — §11.3. Requested lazily from Settings when the officer
      turns the daily digest on, never at launch; the app is fully usable if it is denied.

      There is deliberately NO android.permission.INTERNET: C1 makes the app permanently offline,
      and §8.5's "check for a newer flag notice" hands a URL to the system browser rather than
      fetching anything itself.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DeckWatchApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeckWatch">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.DeckWatch.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          WorkManager is initialised on demand through DeckWatchApplication's
          Configuration.Provider, so that DueRecomputeWorker (@HiltWorker, §11.2) is built by the
          HiltWorkerFactory with its dependencies injected. Removing the default androidx.startup
          initialiser is the other half of that: leave it in and it wins the race, the factory is
          never consulted, and the 03:00 job fails to instantiate its worker.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
